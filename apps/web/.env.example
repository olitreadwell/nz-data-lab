# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (optional)
# DATABASE_URL=postgres://user:pass@localhost:5432/dbname

# Stats NZ Aotearoa Data Explorer API (optional; free key at https://portal.apis.stats.govt.nz)
# Keyless access covers the dataflow catalogue and AGR_* tables as CSV. The key
# unlocks codelists, jsondata, and the remaining tables.
# STATS_NZ_SUBSCRIPTION_KEY=

# DigitalNZ (National Library) v3 API (optional; free key at https://api.digitalnz.org/v3)
# Keyless access works; the key raises the rate limit.
# DIGITAL_NZ_API_KEY=

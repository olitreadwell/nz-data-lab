{
  "name": "@nzlab/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-csp.mjs",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "clean": "rm -rf .next .turbo tsconfig.tsbuildinfo",
    "clean:all": "rm -rf .next .turbo tsconfig.tsbuildinfo node_modules"
  },
  "dependencies": {
    "@nzlab/nz-sources": "*",
    "@nzlab/stats-nz": "^0.0.0",
    "@nzlab/ui": "*",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "fast-xml-parser": "^5.11.0",
    "gsap": "^3.12.7",
    "leaflet": "^1.9.4",
    "leva": "^0.9.35",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "postprocessing": "^6.36.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "three": "^0.183.2",
    "zod": "^3.23",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@nzlab/config-eslint": "*",
    "@nzlab/config-tailwind": "*",
    "@nzlab/config-typescript": "*",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.39.5",
    "jest-axe": "^9.0.0",
    "postcss": "^8.5.2",
    "sass": "^1.86.0",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}

{
  "name": "@nzlab/root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.17.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "next start",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "test": "turbo test",
    "test:watch": "vitest",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "turbo test:e2e",
    "test:a11y": "turbo test:a11y",
    "perf": "pnpm dlx @lhci/cli@latest autorun",
    "smoke": "bash scripts/smoke.sh",
    "check:links": "node scripts/check-internal-links.mjs",
    "audit": "pnpm audit",
    "test:setup": "node --test scripts/setup.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:setup && npm run build && npm run smoke && npm run test:e2e && npm run check:links",
    "prepare": "husky",
    "type-check": "turbo type-check",
    "test:unit": "turbo test --",
    "test:visual": "turbo test:visual",
    "storybook": "turbo storybook --filter=@nzlab/ui",
    "build:storybook": "turbo build-storybook --filter=@nzlab/ui",
    "clean": "rm -rf .turbo apps/*/.next apps/*/.turbo apps/*/dist apps/*/tsconfig.tsbuildinfo apps/*/coverage apps/*/playwright-report apps/*/test-results packages/*/.turbo packages/*/dist packages/*/tsconfig.tsbuildinfo packages/*/.rollup.cache packages/*/coverage packages/*/storybook-static",
    "clean:all": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.next apps/*/.turbo apps/*/dist apps/*/tsconfig.tsbuildinfo apps/*/coverage apps/*/playwright-report apps/*/test-results packages/*/.turbo packages/*/dist packages/*/tsconfig.tsbuildinfo packages/*/.rollup.cache packages/*/coverage packages/*/storybook-static && npm cache clean --force"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,scss,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,mjs}": "eslint --fix --no-warn-ignored"
  },
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tar": "^7.5.22",
    "js-yaml": "^4.3.1",
    "smol-toml": "^1.6.1",
    "@tootallnate/once": "2.0.1",
    "on-headers": "1.1.0",
    "@vercel/node": {
      "undici": "^6.28.0",
      "path-to-regexp": "^6.3.0"
    },
    "vercel": {
      "undici": "^6.28.0"
    },
    "@vercel/express": {
      "path-to-regexp": "^8.4.0"
    },
    "@vercel/hono": {
      "path-to-regexp": "^8.4.0"
    },
    "@vercel/remix-builder": {
      "path-to-regexp": "^6.3.0"
    },
    "@vercel/static-config": {
      "ajv": "^8.18.0"
    },
    "serve-handler": {
      "minimatch": "^3.1.4"
    },
    "@vercel/python-analysis": {
      "minimatch": "^10.2.3"
    },
    "@vercel/fun": {
      "path-to-regexp": "^8.4.0"
    },
    "@vercel/backends": {
      "path-to-regexp": "^8.4.0"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.3.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "^9.0.11",
    "jsdom": "30.0.1",
    "pino-pretty": "13.1.3",
    "prettier": "^3.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vitest-axe": "0.1.0",
    "@clack/prompts": "^0.7",
    "@eslint/js": "^9.39.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "ajv": "^8",
    "globals": "^17.4.0",
    "lint-staged": "^15.2.10",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.6",
    "vercel": "59.1.4"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "lucide-react": "1.34.0",
    "next": "16.3.2",
    "nodemailer": "9.0.5",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  }
}
